{
	"manifest_version": 3,
	"name": "快连AI",
	"version": "3.0.1",
	"description": "快速连接大模型，管理与测试端点，多模型同时对话",
	"author": "magicall",
	"homepage_url": "https://github.com/magicall/kuai-lian-ai",
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": [
		"storage"
	],
	"host_permissions": [
		"https://*/*",
		"http://*/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "快连AI",
		"default_icon": {
			"16": "icons/icon-16.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:"
	}
}